+/* Modified 2026-11-01: file passwords are the default without OpenDirectory (APSL 2.0 section 2.2(b)). */
 #include <TargetConditionals.h>
 
 #define _PASSWD_FILE "/etc/master.passwd"
@@ -172,7 +173,7 @@ main(int argc, char *argv[])
 	int free_user = 0;
 	int res = -1;
 
