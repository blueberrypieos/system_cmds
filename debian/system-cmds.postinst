#!/bin/sh
# SPDX-License-Identifier: BSD-2-Clause
# Copyright (c) 2026 The Blueberry Pie OS Authors
set -e
if [ "$1" = configure ]; then
	for d in /private/var/at /private/var/at/jobs /private/var/at/spool; do
		dpkg-statoverride --list "$d" > /dev/null ||
			dpkg-statoverride --quiet --update --add '#1' '#0' 0755 "$d"
	done
	if [ -z "$2" ] || dpkg --compare-versions "$2" lt 1042.120.1+ds2-2; then
		old="${DPKG_ROOT:-}/private/var/at"
		etc="${DPKG_ROOT:-}/private/etc"
		for n in at.allow at.deny; do
			if [ -f "$old/$n" ] && [ ! -e "$etc/$n" ]; then
				mv "$old/$n" "$etc/$n"
			fi
		done
		if [ ! -e "$etc/at.allow" ] && [ ! -e "$etc/at.deny" ] &&
			{ [ -z "$2" ] || dpkg --compare-versions "$2" lt 1042.120.1+ds2-1; }; then
			: > "$etc/at.deny"
			chown 0:0 "$etc/at.deny"
			chmod 644 "$etc/at.deny"
		fi
	fi
fi
